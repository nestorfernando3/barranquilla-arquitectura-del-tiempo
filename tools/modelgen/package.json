{
  "name": "bq-modelgen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Generador procedural de modelos GLB para el atlas Barranquilla: Arquitectura del tiempo",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:all": "node build-all.mjs && node optimize-web.mjs",
    "validate:all": "node build-all.mjs --validate-only",
    "build:web": "node optimize-web.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.1.0"
  },
  "devDependencies": {
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "meshoptimizer": "^1.3.0"
  }
}
